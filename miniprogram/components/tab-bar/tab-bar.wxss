.tab-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: 100rpx;
  background: var(--color-white);
  border-top: 1rpx solid var(--color-border);
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.tab-bar__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 8rpx 0;
}

.tab-bar__icon {
  font-size: 40rpx;
  line-height: 1;
}

.tab-bar__text {
  font-size: 20rpx;
  color: var(--color-text-secondary);
}

.tab-bar__item--active .tab-bar__text {
  color: var(--color-primary);
  font-weight: 500;
}
