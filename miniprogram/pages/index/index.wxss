.page-index {
  min-height: 100vh;
  padding-bottom: 20rpx;
}

/* 顶部区块 */
.index-header {
  background: linear-gradient(135deg, #e4393c 0%, #ff4d4f 100%);
  padding: 40rpx 32rpx 48rpx;
  color: #fff;
  position: relative;
  overflow: hidden;
}

.index-header::after {
  content: '';
  position: absolute;
  top: -60rpx;
  right: -40rpx;
  width: 200rpx;
  height: 200rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 50%;
}

.index-header__title {
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
  position: relative;
  z-index: 1;
}

.index-header__subtitle {
  font-size: 26rpx;
  opacity: 0.8;
  margin-bottom: 32rpx;
  position: relative;
  z-index: 1;
}

.index-header__publish-btn {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 40rpx;
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 40rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  position: relative;
  z-index: 1;
  backdrop-filter: blur(10rpx);
}

.index-header__publish-btn--hover {
  background: rgba(255, 255, 255, 0.35);
}

.index-header__publish-icon {
  font-size: 32rpx;
  font-weight: 300;
}

/* 统计条 */
.index-stats {
  padding: 24rpx 32rpx 8rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.index-stats__num {
  color: var(--color-primary);
  font-weight: 600;
}

/* 列表 */
.index-list {
  height: calc(100vh - 280rpx);
}

.index-list__loading,
.index-list__end {
  text-align: center;
  padding: 30rpx 0;
  font-size: 24rpx;
  color: var(--color-text-light);
}

/* code-card 在首页的 margin 由组件自身控制 */
