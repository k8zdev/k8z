.page-publish {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.publish-form {
  flex: 1;
  padding: 24rpx;
}

/* 表单组 */
.form-group {
  background: var(--color-white);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  margin-bottom: 24rpx;
  position: relative;
}

.form-label {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 20rpx;
}

.form-textarea {
  width: 100%;
  min-height: 180rpx;
  padding: 24rpx;
  background: #fafafa;
  border-radius: var(--radius);
  font-size: 28rpx;
  line-height: 1.8;
  color: var(--color-text);
  box-sizing: border-box;
  border: 1rpx solid var(--color-border);
}

.form-counter {
  text-align: right;
  font-size: 22rpx;
  color: var(--color-text-light);
  margin-top: 12rpx;
}

.form-hint {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  margin-top: 20rpx;
  padding: 20rpx;
  background: #fffbe6;
  border-radius: var(--radius);
  font-size: 24rpx;
  color: #8c6d00;
  line-height: 1.6;
}

.form-hint__icon {
  flex-shrink: 0;
}

/* 使用须知 */
.form-notice {
  background: var(--color-white);
  border-radius: var(--radius-lg);
  padding: 32rpx;
}

.form-notice__title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 16rpx;
}

.form-notice__item {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 2;
}

/* 底部提交 */
.publish-footer {
  padding: 20rpx 32rpx;
}

.publish-btn {
  width: 100%;
  padding: 28rpx 0;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  background: #ccc;
  border: none;
  transition: background 0.3s;
}

.publish-btn--active {
  background: linear-gradient(135deg, #e4393c, #ff4d4f);
}

.publish-btn--hover {
  opacity: 0.9;
}
